# Copy this file to ".env" and fill in your key.
# .env is read automatically by compare.py. Never commit your real .env.

# The Odds API — free tier 500 requests/month: https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# Anthropic API — for football + GAA intelligence analysis (form, injuries, conditions)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SportBex — Betfair Exchange passthrough, used for the GAA tab's vig-free
# "fair line" (event type 2152880 = Gaelic Games). Trial key: https://sportbex.com
SPORTBEX_API_KEY=your_sportbex_api_key_here

# GAA Paddy Power push (Option B): Paddy Power is Cloudflare/geo-blocked from
# cloud IPs, so pp_push.py runs on a residential Irish machine and POSTs odds to
# the hosted app. Set the SAME secret here (hosted app) and where pp_push.py runs.
GAA_PUSH_SECRET=choose_a_long_random_secret

# Optional: persist the pushed snapshot across Render free-tier spin-downs.
# Create a free Upstash Redis DB (https://upstash.com) and paste its REST creds.
# Without these, the snapshot lives in memory (lost on restart, repushed next run).
#UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
#UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Polymarket Gamma API: public read access, NO key needed.
# Kalshi: public market-data reads need NO key. (Trading would need one.)

# --- Optional tuning (paid Odds API plan) ---
# How often to refresh odds in the background (minutes). Default 15.
# Set to 0 to disable auto-refresh and use the frugal 2h request-driven cache
# (free-tier behaviour). Floor is 5 minutes.
#ODDS_REFRESH_MINUTES=15

# Odds API regions to request. Default "uk" (covers Irish-accessible books).
# Widen on the paid plan e.g. "uk,eu" — also widen BOOKMAKER_WHITELIST below.
#ODDS_REGIONS=uk

# Comma-separated bookmakers to show. Default is the Irish-books set:
#BOOKMAKER_WHITELIST=Paddy Power,Betfair,Betfair Exchange,Bet365,BoyleSports,Ladbrokes,William Hill
