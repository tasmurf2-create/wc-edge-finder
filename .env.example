# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- Required -------------------------------------------------------------

# The Odds API — bookmaker prices. Free tier: 500 credits/month.
# https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# Anthropic API — the club-football analyst (research + match analysis).
# https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ---- Recommended ----------------------------------------------------------

# Unlocks the owner-only Admin tab (#/admin) and /admin/stats.
# If unset, a random key is generated per restart and printed to the logs.
ADMIN_KEY=choose_a_long_random_secret

# Exchange commission, as a decimal (0.02 = 2%).
# Exchange prices in the feed are PRE-commission, and exchanges post the best raw
# price on most outcomes — so if this is wrong, every edge on the site is wrong.
# Set it to YOUR actual rate (Betfair 2-5% by loyalty, Smarkets ~2%).
EXCHANGE_COMMISSION=0.02


# ---- Quota control (read before changing) ---------------------------------

# The Odds API bills [markets] x [regions] credits PER LEAGUE request. With the
# defaults (3 markets, uk, 3 leagues) one full refresh costs 9 credits, against
# a 500/month free tier — about 55 refreshes total.

# Background refresh cadence in minutes. 0 = OFF (demand-driven), the free-tier
# default: odds are only re-fetched when someone loads the app and the snapshot
# is stale. An idle app spends nothing. On a paid plan, try 15.
ODDS_REFRESH_MINUTES=0

# Demand-driven cache TTL in minutes (default 360 = 6h).
#ODDS_CACHE_MINUTES=360

# Odds regions. "uk" covers the Irish-accessible books. Widening to "uk,eu"
# DOUBLES credit burn for a handful of extra books — remember to widen
# BOOKMAKER_WHITELIST too, or they get filtered out anyway.
#ODDS_REGIONS=uk

# Which books to show prices from (comma-separated, matched on the feed's titles).
#BOOKMAKER_WHITELIST=Paddy Power,Betfair,Bet365,BoyleSports,Ladbrokes,William Hill


# ---- Analyst tuning -------------------------------------------------------

# Concurrent analyst calls. Keep at 1 on Anthropic Tier 1: parallel calls all 429
# and then burn their retry budgets re-sending tokens, which is slower overall.
# Raise only on a higher tier.
#INTEL_WORKERS=1
